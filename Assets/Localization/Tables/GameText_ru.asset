  - m_Id: 2111780675584
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258496
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258497
    m_Localized: "\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258498
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258499
    m_Localized: "\u041A\u0443\u0439. \u0421\u043F\u0443\u0441\u043A\u0430\u0439\u0441\u044F.
      \u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258500
    m_Localized: "\u0417\u0432\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258501
    m_Localized: "\u0413\u0440\u0430\u0444\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258502
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258503
    m_Localized: "\u042D\u0444\u0444\u0435\u043A\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258504
    m_Localized: "\u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0432\u0435\u0441\u044C
      \u0437\u0432\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258505
    m_Localized: "\u0420\u0435\u0436\u0438\u043C \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258506
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258507
    m_Localized: "\u0412\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u0430\u044F
      \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258508
    m_Localized: "\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435
      FPS"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258509
    m_Localized: "\u041C\u0430\u0441\u0448\u0442\u0430\u0431 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258510
    m_Localized: "\u0414\u0440\u043E\u0436\u0430\u043D\u0438\u0435 \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2111793258511
    m_Localized: "\u0418\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 4995809271808
    m_Localized: "\u0420\u0443\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020544
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0444\u043E\u0440\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020545
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020546
    m_Localized: "\u0420\u0443\u0434\u0430 \u043F\u043B\u0430\u0432\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020547
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0435\u0432 \u2014 \u043C\u0435\u0442\u0430\u043B\u043B
      \u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020548
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u043E\u0441\u0442\u044B\u043B \u2014
      \u043F\u043E\u0434\u043A\u0438\u043D\u044C\u0442\u0435 \u0431\u0440\u0435\u0432\u043D\u043E,
      \u0438\u043D\u0430\u0447\u0435 \u0440\u0443\u0434\u0430 \u043D\u0435 \u043F\u043B\u0430\u0432\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020549
    m_Localized: "\u0420\u0443\u0434\u0430 \u043F\u043B\u0430\u0432\u0438\u0442\u0441\u044F
      \u2014 \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u0436\u0430\u0440. \u0420\u0430\u043D\u043E
      \u043B\u0438\u0442\u044C = \u0441\u043B\u0430\u0431\u0430\u044F \u043A\u043E\u0432\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020550
    m_Localized: "\u0420\u0430\u0441\u043F\u043B\u0430\u0432 \u0433\u043E\u0442\u043E\u0432
      \u2014 \u043D\u0430\u043A\u043B\u043E\u043D\u0438\u0442\u0435 \u043A\u043E\u0442\u0451\u043B,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043B\u0438\u0442\u044C \u0444\u043E\u0440\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020551
    m_Localized: "\u041C\u0435\u0442\u0430\u043B\u043B \u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F \u2014 \u043B\u0435\u0439\u0442\u0435
      \u0441\u043A\u043E\u0440\u0435\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020552
    m_Localized: "\u043C\u0430\u0441\u0441\u0430 {0} \xB7 \u0447\u0438\u0441\u0442\u043E\u0442\u0430
      {1}% \xB7 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020553
    m_Localized: "\u043F\u043B\u0430\u0432\u043A\u0430 {0}% \xB7 \u0437\u0430\u043B\u0438\u0432\u043A\u0430
      {1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020554
    m_Localized: "\u0417\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043A\u043B\u0438\u043D\u043A\u0430
      ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020555
    m_Localized: "\u041B\u0438\u0442\u0430\u044F \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020556
    m_Localized: "\u0443\u0440\u043E\u043D {0} \xB7 \u043F\u0440\u043E\u0447. {1}
      \xB7 {2} \u0437\u043E\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020557
    m_Localized: " \xB7 \u0434\u0435\u0444\u0435\u043A\u0442\u043E\u0432: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020558
    m_Localized: "[\u043B\u043E\u043C]"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020559
    m_Localized: "[\u043F\u043E\u0440\u0438\u0441\u0442\u044B\u0439]"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020560
    m_Localized: "[\u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0442]"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020561
    m_Localized: "\u0411\u0440\u043E\u043D\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 4995847020562
    m_Localized: "\u0422\u0443\u0433\u043E\u043F\u043B\u0430\u0432\u043A\u0430\u044F,
      \u043D\u0430\u0434\u0451\u0436\u043D\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327278432256
    m_Localized: "\u0413\u043B\u0443\u0431\u0438\u043D\u0430: {0} \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327328763904
    m_Localized: "I \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327328763905
    m_Localized: "\u041F\u0430\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327328763906
    m_Localized: "\u0412\u044B\u0445\u043E\u0434 \u0432 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327328763907
    m_Localized: "\u0425\u043E\u0434: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327328763908
    m_Localized: "\u0418\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0432\u044B\u0445\u043E\u0434\u044F\u0442
      \u0432\u0440\u0430\u0433\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327328763909
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0430!  +{0} \u0440\u0443\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327328763910
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u043F\u0430\u043B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2149327328763911
